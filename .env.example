# --- Clés API (obligatoires pour la génération automatique) ---
# Clé Claude : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Clé ElevenLabs : https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- Options (facultatives) ---
# Port du serveur web
PORT=3000
# Mot de passe pour protéger l'interface quand elle est en ligne (laisser vide en local)
APP_PASSWORD=
# Modèle Claude utilisé pour le script
CLAUDE_MODEL=claude-opus-5-5
# Nombre d'onglets Chrome en parallèle pendant le rendu (laisser vide = automatique)
RENDER_CONCURRENCY=
# Mode OpenGL pour la 3D : swangle (CPU, marche partout) ou angle (GPU)
REMOTION_GL=swangle
# Chemin vers un Chrome headless déjà installé (laisser vide = téléchargement automatique)
REMOTION_BROWSER_EXECUTABLE=
